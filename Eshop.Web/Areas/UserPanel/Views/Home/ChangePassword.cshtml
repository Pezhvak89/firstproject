@using Eshop.Domain.ViewModels.User
@model Eshop.Domain.ViewModels.User.ChangePasswordViewModel

@{
    ViewData["Title"] = "تغییر کلمه عبور";
}

<h4>@ViewData["Title"]</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        @{
            if (ViewData["Result"] != null)
            {
                ChangePasswordResult result = (ChangePasswordResult)ViewData["Result"];
                if (result == ChangePasswordResult.Success)
                {
                    <div class="alert alert-success">
                        تغییر کلمه عبور انجام شد.
                    </div>
                }
                else if (result == ChangePasswordResult.InvalidPassword)
                {
                    <div class="alert alert-danger">
                         کلمه عبور قبلی صحیح نیست.
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        خطایی رخ داده است.
                    </div>
                }
            }
        }
        <form asp-action="ChangePassword" method="post">
            <div class="form-group">
                <label asp-for="OldPassword" class="control-label"></label>
                <input asp-for="OldPassword" class="form-control"/>
                <span asp-validation-for="OldPassword" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password" class="control-label"></label>
                <input asp-for="Password" class="form-control"/>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RePassword" class="control-label"></label>
                <input asp-for="RePassword" class="form-control"/>
                <span asp-validation-for="RePassword" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="ثبت" class="btn btn-primary"/>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
