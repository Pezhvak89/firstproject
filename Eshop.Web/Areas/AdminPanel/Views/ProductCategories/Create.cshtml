@model Eshop.Domain.ViewModels.ProductCategory.CreateproductCategoryViewModel

@{
    ViewData["Title"] = "دسته بندی جدید";
}
<div class="row">
    <div class="col-md-12">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="CategoryTittle" class="control-label"></label>
                <input asp-for="CategoryTittle" class="form-control" />
                <span asp-validation-for="CategoryTittle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="ثبت" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>


