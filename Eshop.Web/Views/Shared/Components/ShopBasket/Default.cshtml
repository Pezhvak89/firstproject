@model IEnumerable<Eshop.Domain.Models.Basket.OrderDetails>

<section class="border-radius basket-side">
    <header><h3> سبد خرید شما  </h3></header>
    <article>
        <ul>
           @foreach (var item in Model)
           {
               <li>
                   <img class="border-radius" src="/productImages/@item.Product.ProductImages.FirstOrDefault()?.ImageName">
                   <div class="left-basket">
                       <a asp-controller="Product" asp-action="ShowProduct" asp-route-productId="@item.Product.ProductId">@item.Product.Title <span class="border-radius"> @item.Count </span></a>
                   </div>
               </li>
           }
            
        </ul>
        <a asp-area="UserPanel" asp-controller="Orders" asp-action="Index" class="show-basket-button border-radius">مشاهده سبد خرید</a>
    </article>
</section>
