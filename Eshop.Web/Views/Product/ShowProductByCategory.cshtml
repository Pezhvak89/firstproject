@model IEnumerable<Eshop.Domain.Models.Products.Product>
@{
    ViewData["Title"] = "Home Page";
}

<section class="last-products">
    <header><h3> جدیدترین محصولات @ViewData["CategoryTitle"]</h3> <a href=""> آرشیو </a></header>
    <article>

       @foreach (var item in Model)
       {
           <partial name="_BoxProduct" model="item"/>
       }

        <div class="clearfix"></div>
    </article>
</section>


@section Slider{
    <div class="slider-layer">
        <div id="slider-one" class="owl-carousel">
            <div class="item">
                <a href=""><img src="/Site/img/slider.jpg" title="تست عنوان"></a>
            </div>
            <div class="item">
                <a href=""><img src="/Site/img/slider.jpg" title="تست عنوان"></a>
            </div>
        </div>
    </div>
}
